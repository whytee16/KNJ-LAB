# Скопируйте в .env.local и заполните. Никогда не коммитьте реальные значения.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=ru
APP_TIMEZONE=Asia/Almaty

# --- Supabase (self-hosted в РК; локально — supabase start) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # только сервер/worker
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Redis (rate limiting) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Payments (sandbox) ---
PAYMENT_PROVIDER=                   # например: freedompay | cloudpayments | halyk
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# --- Fiscal receipts ---
FISCAL_PROVIDER=
FISCAL_API_KEY=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- TTS (этап 9, опционально) ---
TTS_PROVIDER=                       # elevenlabs | yandex | kazakhtts
ELEVENLABS_API_KEY=
YANDEX_SPEECHKIT_API_KEY=

# --- Observability ---
SENTRY_DSN=
