# Скопируйте в .env.local и заполните. Никогда не коммитьте реальные значения.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=ru
APP_TIMEZONE=Asia/Almaty

# --- Supabase (self-hosted в РК; локально — `pnpm db:start`, ключи — `supabase status`) ---
# NEXT_PUBLIC_* встраиваются при сборке: задайте их до `pnpm build`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # только сервер; никогда не в браузер

# --- Accounts ---
IP_HASH_SALT=                       # ≥ 16 символов, случайная строка; IP хранятся только как хэш
REGISTRATION_ENABLED=false          # true — открыть самостоятельную регистрацию родителей
STUDENT_EMAIL_DOMAIN=student.knj.invalid   # технические адреса учеников, только домен .invalid

# --- Payments (sandbox) ---
PAYMENT_PROVIDER=                   # например: freedompay | cloudpayments | halyk
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# --- Fiscal receipts ---
FISCAL_PROVIDER=
FISCAL_API_KEY=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- TTS (этап 9, опционально) ---
TTS_PROVIDER=                       # elevenlabs | yandex | kazakhtts
ELEVENLABS_API_KEY=
YANDEX_SPEECHKIT_API_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Public site ---
NEXT_PUBLIC_CONTACT_EMAIL=          # показывается в подвале, если задан

# --- Build ---
NEXT_OUTPUT=                        # standalone — для production Docker-образа (этап 8)
