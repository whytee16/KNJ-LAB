{
  "name": "knj-lab",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@knj/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @knj/web test:e2e",
    "i18n:check": "pnpm --filter @knj/i18n check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "supabase": "3.2.0"
  }
}
